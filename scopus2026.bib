	affiliations = {School of Computer Science and Engineering, South China University of Technology, Guangdong, Guangzhou, 510006, China; Department of Informatics and Computer Systems College of Computer Science, King Khalid University, Abha, Saudi Arabia; College of Computer Science and Engineering, University of Jeddah, Jeddah, Saudi Arabia; Department of Computer Science & Information Technology, The Islamia University of Bahawalpur, Bahawalpur, 63100, Pakistan; Scuola IMT Alti Studi Lucca, Italy; University of Salerno, Italy},
	abstract = {The deployment of deep learning in safety-critical computer vision applications has exposed fundamental vulnerabilities to adversarial attacks, while existing defense mechanisms lack the interpretability required for trust-critical deployment in regulated domains such as autonomous driving, medical diagnostics, and facial recognition systems. This paper presents SentriShield-VQ, a novel explainable adversarial defense framework that synergistically integrates variational quantum encoding with self-adaptive visual reasoning and human-interpretable attribution mechanisms to secure deep learning vision models against comprehensive attack taxonomies. The proposed framework introduces four principal contributions: (1) a quantum-driven sentinel module leveraging parameterized quantum circuits to detect Fast Gradient Sign Method (FGSM), Projected Gradient Descent (PGD), Basic Iterative Method (BIM), Carlini-Wagner (CW), DeepFool, and clean-label poisoning attacks through latent-space curvature analysis; (2) a progressive quantum-inspired purification process that removes adversarial distortions while preserving semantic content; (3) a contextual re-validation module ensuring geometric consistency of purified outputs; and (4) a comprehensive explainable AI (XAI) module providing amplitude-based feature attribution, quantum gate contribution analysis, and spatial perturbation localization that enables security analysts to validate defense decisions, diagnose failure modes, and establish trust through human-interpretable visualizations. The XAI framework quantifies detection rationale by backpropagating quantum amplitude contributions to input pixels, decomposing variational quantum circuit gate importance across rotation and entanglement operations, and localizing adversarial artifacts with patch-level precision. Comprehensive experiments on CIFAR-100 and ImageNet-1K benchmarks across autonomous driving, facial analysis, and medical imaging scenarios demonstrate that SentriShield-VQ achieves 97.25% detection accuracy, 72.45% robust accuracy under PGD-20 attack, and 62.51% average accuracy recovery on purified adversarial inputs, while maintaining 77.34% clean accuracy with only 2.11% degradation. The explainability module attains 91.3% attribution fidelity and 0.915 perturbation localization F1-score, with human interpretability studies establishing 87.2% analyst understanding scores and 4.18/5.0 trust ratings. The framework outperforms ten state-of-the-art defense methods by 14.0% in robust accuracy while uniquely providing actionable interpretability absent in existing black-box defenses, establishing a new paradigm for accountable and auditable adversarial defense in safety-critical computer vision systems. © 2026 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	author_keywords = {Adversarial defense; Adversarial purification; Attribution methods; Computer vision security; Deep neural network robustness; Explainable artificial intelligence; Human-interpretable AI; Interpretable machine learning; Multi-vector attacks; Quantum machine learning; Trustworthy AI; Variational quantum circuits},
