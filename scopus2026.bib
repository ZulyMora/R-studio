	language = {English},
	abbrev_source_title = {Adv Mater},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 44}
}

@ARTICLE{Zhuang2026,
	author = {Zhuang, Jianglong and Liu, Bin and Liu, Xu and Guan, Guizheng},
	title = {Simultaneous Multi-Task Photonic Reservoir Computing via Virtual Node Partitioning in a Single Optical-Feedback Semiconductor Laser},
	year = {2026},
	journal = {Engineered Science},
	volume = {40},
