	keywords = {Cost benefit analysis; Cost effectiveness; Deep learning; Energy utilization; Historic preservation; Intelligent buildings; Hybrid deep learning; MLP model; Modeling architecture; Non-invasive sensing; NSGA-II; NSGA-II optimization; Occupancy estimation; Optimal model; Optimal model architecture; Optimisations; Economic and social effects},
