@ARTICLE{Akter2025,
	author = {Akter, Shahrin and Haider, Mohammad Rafiqul},
	title = {mTanh: A Low-Cost Inkjet-Printed Vanishing Gradient Tolerant Activation Function †},
	year = {2025},
	journal = {Journal of Low Power Electronics and Applications},
	volume = {15},
	number = {2},
