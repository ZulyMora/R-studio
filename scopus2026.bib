	correspondence_address = {F. Aslam; Department of Civil Engineering, College of Engineering in Al-Kharj, Prince Sattam Bin Abdulaziz University, Al-Kharj, 11942, Saudi Arabia; email: f.aslam@psau.edu.sa},
