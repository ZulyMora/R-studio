	keywords = {Benchmarking; Graph neural networks; Graph structures; Graph theory; Graphic methods; Learning systems; Network topology; Semantics; Auto encoders; Class imbalance; Data augmentation; Generalization ability; Graph neural networks; Graph structured data; Multi-views; Node classification; Subgraphs; Uncertainty; Classification (of information); Interpolation},
