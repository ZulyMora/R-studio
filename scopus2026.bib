	year = {2026},
	journal = {Computers and Electrical Engineering},
	volume = {139},
	pages = {},
	doi = {10.1016/j.compeleceng.2026.111358},
	url = {https://www.scopus.com/pages/publications/105043581522?origin=resultslist},
	affiliations = {School of Computing, Sathyabama Institute of Science and Technology, Tamil Nadu, India; Department of CSE, Sathyabama Institute of Science and Technology, Tamil Nadu, India},
	abstract = {Video steganography is an essential method for achieving secure and covert communication. While classical models have laid the foundation for this field, they face several notable demerits that limit their effectiveness in practical applications. To address the limitations, this research proposes a novel approach named Temporal Tversky Expectation Tanimoto- Loss (TeTET-Loss). This model is developed with an embedding and extraction phase. For embedding, the input video undergoes a deduplication process, key frame extraction, motion-based index prediction, and textural features extraction. Subsequently, the region of interest selection is conducted using the proposed TeTET-Loss function with a quantum-inspired correlative capsule network. In parallel, the Empirical Wavelet Transform is applied to the motion vector predicted result. In the extraction phase, the compressed video is decompressed. Then the embedding of the video is performed. After that, motion-based prediction is done, and the Empirical Wavelet Transform is applied to attain the secret image. Here, the key used for decryption is the region of interest. Moreover, the devised model has obtained Correlation coefficient, Peak Signal to Noise Ratio, Normalized Mean Square Error and Structural Similarity Index Measure as 0.923, 35.015 dB, 0.108, and 0.963. © 2026 Elsevier Ltd.},
	author_keywords = {Deep channel-attention correlative capsule network; Deep learning; Empirical wavelet transform; Quantum-inspired convolutional neural network; Video steganography},
	keywords = {Deep neural networks; Embeddings; Extraction; Mean square error; Motion estimation; Video signal processing; Wavelet transforms; Convolutional neural network; Deep channel-attention correlative capsule network; Deep learning; Embeddings; Empirical wavelet transform; Extraction phase; Loss functions; Quantum-inspired convolutional neural network; Video steganography; Wavelets transform; Signal to noise ratio; Steganography},
	correspondence_address = {S. S․ K; School of Computing, Sathyabama Institute of Science and Technology, Tamil Nadu, India; email: sameerask.25@gmail.com},
	publisher = {Elsevier Ltd},
	issn = {00457906},
