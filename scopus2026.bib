@ARTICLE{Wu2021,
	author = {Wu, Tao and Shi, Jiao and Zhou, Deyun and Zheng, Xiaolong and Li, Na},
	title = {Evolutionary multi-objective one-shot filter pruning for designing lightweight convolutional neural network},
	year = {2021},
	journal = {Sensors},
	volume = {21},
