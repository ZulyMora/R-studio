	affiliations = {Jilin University, College of Computer Science and Technology, Changchun, 130012, China; Aberystwyth University, School of Environmental and Rural Sciences, Aberystwyth, SY23 3FL, United Kingdom; The First Hospital of Jilin University, Department of Obstetrics, Changchun, 130031, China; The First Hospital of Jilin University, Department of Hepatobiliary and Pancreatic Surgery, Changchun, 130031, China; Second Affiliated Hospital of Harbin Medical University, Department of Hepatopancreatobiliary Surgery, Harbin, 150001, China},
	abstract = {Pancreatic cancer is one of the most malignant cancers with rapid progression and poor prognosis. The use of transcriptional data can be effective in finding new biomarkers for pancreatic cancer. Many network-based methods used to identify cancer biomarkers are proposed, among which the combination of network controllability appears. However, most of the existing methods do not study RNA, rely on priori and mutations information, or can only achieve classification tasks. In this study, we propose a method combined Relational Graph Convolutional Network and Deep Q-Network called RDDriver to identify pancreatic cancer biomarkers based on multi-layer heterogeneous transcriptional regulation network. Firstly, we construct a regulation network containing long non-coding RNA, microRNA, and messenger RNA. Secondly, Relational Graph Convolutional Network is used to learn the node representation. Finally, we use the idea of Deep Q-Network to build a model, which score and prioritize each RNA with the Popov-Belevitch-Hautus criterion. We train RDDriver on three small simulated networks, and calculate the average score after applying the model parameters to the regulation networks separately. To demonstrate the effectiveness of the method, we perform experiments for comparison between RDDriver and other eight methods based on the approximate benchmark of three types cancer drivers RNAs.  © 2002-2011 IEEE.},
	author_keywords = {Pancreatic cancer biomarkers; Popov-Belevitch-Hautus criterion; relational graph convolutional network; transcriptional regulation network},
	keywords = {Algorithms; Biomarkers, Tumor; Computational Biology; Deep Learning; Gene Regulatory Networks; Humans; MicroRNAs; Neural Networks, Computer; Pancreatic Neoplasms; RNA, Long Noncoding; Benchmarking; Deep reinforcement learning; Network theory (graphs); Reinforcement learning; Transcription; long untranslated RNA; microRNA; tumor marker; Benchmark testing; Cancer; Cancer biomarkers; Convolutional networks; Nanobiosciences; Pancreatic cancer biomarker; Pancreatic cancers; Popov-belevitch-hautus criteria; Regulation; Regulation networks; Relational graph; Relational graph convolutional network; Transcriptional regulation; Transcriptional regulation network; algorithm; artificial neural network; bioinformatics; deep learning; gene regulatory network; genetics; human; metabolism; pancreas tumor; procedures; RNA},
