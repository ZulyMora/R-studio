	keywords = {Causality; Humans; Models, Biological; Neural Networks, Computer; Benchmarking; Computation theory; Computational methods; Dynamics; Large scale systems; Molecular biology; Perturbation techniques; Signal processing; State space methods; Dual orthogonal decomposition; Interventional; Interventional causality; Latent confounders; Network inference; Non-interventional system; Orthogonal decomposition; Scientific discovery; State space reconstruction; air pollution; area under the curve; Article; benchmarking; brain cortex; brain development; cardiovascular disease; clustered regularly interspaced short palindromic repeat; computer model; gene regulatory network; Henon system; interventional dynamical causality under invisible latent confounders; microbial community; plankton; statistical analysis; artificial neural network; biological model; causality; human; Deep neural networks},
