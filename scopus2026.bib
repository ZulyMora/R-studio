	url = {https://www.scopus.com/pages/publications/105034742035?origin=resultslist},
	affiliations = {School of Computer Science, Nanjing University of Information Science and Technology, Nanjing, 210044, China; School of Computer Science and Electronic Engineering, University of Surrey, Guildford, United Kingdom},
	abstract = {Generative Adversarial Networks (GANs) often exhibit unstable training dynamics and strong dependence on manually designed architectures, limiting scalability and robustness. This paper proposes HEAGAN, an efficient hybrid evolutionary neural architecture search framework for GANs. HEAGAN searches the generator architecture only, while the discriminator follows a fixed AutoGAN-style backbone throughout training and evaluation. HEAGAN couples a guided hybrid evolutionary search with a partial weight-sharing supernet to automate generator architecture discovery for unsupervised image synthesis. The search integrates genetic algorithms and particle swarm optimisation, while constrained weight sharing with dynamic node activation reduces weight coupling and mitigates multi-model forgetting during supernet optimisation. To improve training stability, an adaptive robust loss is incorporated, and a multi-objective formulation based on NSGA-II jointly optimises generation quality and distributional fidelity. Experiments on CIFAR-10, STL-10, CIFAR-100, and ImageNet32 show that HEAGAN consistently identifies competitive generator architectures with improved stability and strong transferability across datasets. On CIFAR-10, HEAGAN achieves an Inception Score of 8.99  ±  0.11 and a Fréchet Inception Distance of 8.20. Ablation studies further validate the individual contributions of the proposed components. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	author_keywords = {Generative adversarial networks; Hybrid evolutionary optimisation; Multi-objective optimisation; Neural architecture search; Partial weight sharing; Unsupervised image synthesis},
	keywords = {Architecture; Data mining; Electric generators; Generative adversarial networks; Genetic algorithms; Image enhancement; Memory architecture; Multiobjective optimization; Network architecture; Neural networks; Adversarial networks; Evolutionary Multi-objectives; Hybrid evolutionary optimizations; Images synthesis; Multi-objectives optimization; Neural architecture search; Neural architectures; Partial weight sharing; Strong dependences; Unsupervised image synthesis; Particle swarm optimization (PSO)},
	correspondence_address = {F. Neri; School of Computer Science, Nanjing University of Information Science and Technology, Nanjing, 210044, China; email: f.neri@surrey.ac.uk},
