	author = {Lun, Shuxian and Wang, Qian and Cai, Jianning and Lu, Xiaodong},
	title = {A Multireservoir Echo State Network Combined with Olfactory Feelings Structure},
	year = {2023},
	journal = {Electronics (Switzerland)},
	volume = {12},
	number = {22},
	pages = {},
	doi = {10.3390/electronics12224635},
	url = {https://www.scopus.com/pages/publications/85178378890?origin=resultslist},
	affiliations = {School of Control Science and Engineering, Bohai University, Jinzhou, 121013, China; School of Information Engineering, Suqian University, Suqian, 223800, China},
	abstract = {As a special form of recurrent neural network (RNN), echo state networks (ESNs) have achieved good results in nonlinear system modeling, fuzzy nonlinear control, time series prediction, and so on. However, the traditional single-reservoir ESN topology limits the prediction ability of the network. In this paper, we design a multireservoir olfactory feelings echo state network (OFESN) inspired by the structure of the Drosophila olfactory bulb, which provides a new connection mode. The connection between subreservoirs is transformed into the connection between each autonomous neuron, the neurons in each subreservoir are sparsely connected, and the neurons in different subreservoirs cannot communicate with each other. The OFESN greatly simplifies the coupling connections between neurons in different libraries, reduces information redundancy, and improves the running speed of the network. The findings from the simulation demonstrate that the OFESN model, as introduced in this study, enhances the capacity to approximate sine superposition function and the Mackey–Glass system when combined. Additionally, this model exhibits improved prediction accuracy by 98% in some cases and reduced fluctuations in prediction errors. © 2023 by the authors.},
	author_keywords = {echo state network; reservoir; stochastic gradient descent method; time series prediction},
	correspondence_address = {S. Lun; School of Control Science and Engineering, Bohai University, Jinzhou, 121013, China; email: lunshuxian@qymail.bhu.edu.cn; X. Lu; School of Information Engineering, Suqian University, Suqian, 223800, China; email: 17139@squ.edu.cn},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {20799292},
	language = {English},
	abbrev_source_title = {Electronics (Switzerland)},
	type = {Article},
	publication_stage = {Final},
