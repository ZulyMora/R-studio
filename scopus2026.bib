	correspondence_address = {J. Vallverdú; Philosophy Department, ICREA-UAB, Bellaterra, Barcelona, 08193, Spain; email: jordi.vallverdu@uab.cat},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
