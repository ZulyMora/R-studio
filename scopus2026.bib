	affiliations = {School of Mathematics, Southeast University, Nanjing, 210096, China; College of Mathematics and Computer Science, Zhejiang Normal University, Zhejiang, 321004, China; School of Information Science and Engineering, Chengdu University, Chengdu, 610106, China},
	abstract = {In practical gene regulatory networks, gene expression is often accompanied by stochastic gene mutation. This brief investigates the cluster synchronization problem of Boolean networks (BNs) and Boolean control networks (BCNs) under probabilistic function perturbation, which can better characterize stochastic gene mutation and explore internal synchronization mechanism of the system. By transforming BN into an equivalent stochastic logical system, the algebraic expression of BN (BCN) under probabilistic function perturbation is derived. Then, necessary and sufficient conditions are provided so as to distinguish whether systems can achieve cluster synchronization with probability one under probabilistic function perturbation. Corresponding state feedback controllers are designed as well. The effectiveness is demonstrated by numerical examples.  © 2021 IEEE.},
	author_keywords = {Circuits and systems; Neural networks; Perturbation methods; Probabilistic logic; State feedback; Stochastic processes; Synchronization},
	keywords = {Gene expression; State feedback; Stochastic systems; Synchronization; Algebraic expression; Boolean control networks; Boolean Networks; Cluster synchronization; Corresponding state; Gene regulatory networks; Internal synchronization; Probabilistic functions; Boolean functions},
