	pages = {},
	doi = {10.1016/j.ins.2023.120048},
	url = {https://www.scopus.com/pages/publications/85181803297?origin=resultslist},
	affiliations = {College of Computer Science and Technology, Jilin University, Changchun, 130012, China; Key Laboratory of Symbolic Computation and Knowledge Engineering of Ministry of Education, Jilin University, Changchun, 130012, China; High Performance Computing Center, Jilin University, Changchun, 130012, China},
	abstract = {Network pruning has been a hot topic in recent years, and many popular pruning methods rely on network design expertise. However, the pruning process usually involves manual intervention and can be difficult for users who lack prior knowledge. Automatic pruning using evolutionary algorithms shows great promise, but it must address the challenge of performing time-consuming model evaluations and searching through a large solution space. Dataset distillation is a technique that compresses the original dataset to decrease the cost of fine-tuning models. In this paper, we explore the potential of using the distilled dataset to exhibit a similar role as the real dataset in network pruning, and proposed the evolutionary pruning framework using distilled dataset. Specifically, the network pruning pipeline is carried out on the distilled dataset to significantly reduce the model evaluation cost, and the number of filters in the convolutional layer is directly coded to narrow the search space. In addition, a tailored evolutionary algorithm is proposed that takes the form of constrained optimization to search the most suitable pruned network. The experiments conducted on VGG16, VGG19, ResNet56, and ResNet110 demonstrate that the proposed method reduces at least 41.56% of the flops and achieves competitive results with little compromising accuracy. © 2023 Elsevier Inc.},
	author_keywords = {Constrained evolutionary optimization; Dataset distillation; Deep learning; Evolutionary pruning; Filter pruning},
	keywords = {Constrained optimization; Convolution; Deep learning; Evolutionary algorithms; Constrained evolutionary optimization; Dataset distillation; Deep learning; Evolutionary pruning; Filter pruning; Hot topics; Model evaluation; Network design; Network pruning; Pruning methods; Distillation},
	correspondence_address = {Y. Sun; College of Computer Science and Technology, Jilin University, Changchun, 130012, China; email: yfsun22@mails.jlu.edu.cn},
