	author = {Hasslberger, J. and Reissmann, M. and Sandberg, R.D. and Klein, M.},
	title = {Exploiting semantic backpropagation to impose near-wall scaling constraints in machine-learned symbolic subgrid-scale closures},
	year = {2025},
	journal = {Physics of Fluids},
	volume = {37},
	number = {3},
	pages = {},
	doi = {10.1063/5.0260447},
	url = {https://www.scopus.com/pages/publications/105000931199?origin=resultslist},
	affiliations = {Department of Aerospace Engineering, University of the Bundeswehr Munich, Neubiberg, 85577, Germany; Department of Mechanical Engineering, University of Melbourne, Parkville, 3010, VIC, Australia},
	abstract = {Imposing additional physical constraints can greatly enhance the generalizability of machine-learned models (e.g., physics-informed neural networks). Following this spirit, we suggest a way to impose an additional constraint, specifically the near-wall asymptotic behavior of subgrid-scale (SGS) models, in the context of large eddy simulation (LES) due to its importance for technical applications. In-the-loop, i.e., computational fluid dynamics (CFD) driven, evolutionary optimization of SGS closures, including the near-wall scaling constraint, is implemented by means of combining gene expression programming (GEP) with semantic backpropagation. Theoretical knowledge on the wall scaling of the basis tensors and invariants is therefore provided to the algorithm as a constraint to guide the exploration. Since an a posteriori LES is conducted for each candidate model, the efficiency of the training process is indispensable for sufficient evolutionary exploration, and this is achieved by using around 10 5 coarse grid simulations of the Taylor-Green vortex. It turns out that the wall-constrained GEP variant is able to find almost equally good models as the unconstrained variant, indicating that it maintains excellent exploration capability. Finally, it is demonstrated by means of an a posteriori channel flow LES that the constrained machine-learned model obeys the proper cubic near-wall scaling of the SGS shear stress on wall-refined meshes. It is worth emphasizing that this near-wall property of the model is fulfilled as intended, although the training process avoids the costly a posteriori evaluation of wall-bounded flow configurations. © 2025 Author(s).},
	keywords = {Channel flow; Constrained optimization; Latent semantic analysis; Shear flow; Tensors; Vortex flow; Gene-expression programming; Large-eddy simulations; Near-wall; Neural-networks; Physical constraints; Posteriori; Scaling constraints; Scalings; Subgrid scale; Training process; Shear stress},
	correspondence_address = {J. Hasslberger; Department of Aerospace Engineering, University of the Bundeswehr Munich, Neubiberg, 85577, Germany; email: josef.hasslberger@unibw.de},
