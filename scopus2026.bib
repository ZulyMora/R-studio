@ARTICLE{Lou2025,
	author = {Lou, Junbin and Li, Yixuan and Meng, Hao and Xu, Rongqiao},
	title = {Interpretable data-driven models for the shear strength of perfobond rib shear connectors},
	year = {2025},
	journal = {Engineering Structures},
	volume = {345},
	pages = {},
	doi = {10.1016/j.engstruct.2025.121506},
	url = {https://www.scopus.com/pages/publications/105019649406?origin=resultslist},
	affiliations = {Department of Civil Engineering, Zhejiang University, Hangzhou, 310058, China; Zhejiang Provincial Engineering Research Center for Digital & Smart Maintenance of Highway, Hangzhou, 310051, China},
	abstract = {Perfobond rib shear connectors (PBLs) are key load-transfer components in steel–concrete composite structures and an accurate estimate of their shear capacity is indispensable for reliable design. Prediction remains challenging because the bearing mechanism is governed by strongly coupled interactions between the punched steel plate, concrete dowel, and perforated rebar, and may fail through several concurrent modes, concrete crushing, rebar fracture, or steel plate yielding. Traditional formulae simplify these complex, multi-interaction phenomena into single, dominant mechanisms calibrated from limited datasets, resulting in significant variability and limited generalizability, particularly for high-strength concrete and multi-hole connector configurations. To address these limitations, a comprehensive database of 236 test results focusing exclusively on specimens failing by perforated rebar fracture is compiled from available literature, covering extensive ranges of concrete strength (22.7–156 MPa), hole count (1–4), plate thickness (7–46 mm), and reinforcement configuration. Nine representative machine-learning (ML) algorithms, including artificial neural network (ANN), support vector machine (SVM), k-nearest neighbors (KNN), decision tree (DT), random forest (RF), extremely randomized trees (ET), gradient boosting decision tree (GBDT), extreme gradient boosting (XGBoost), and categorical boosting (CatBoost) are systematically trained and evaluated. Among these algorithms, CatBoost demonstrates superior predictive accuracy and robustness, achieving a coefficient of determination (R<sup>2</sup>) of 0.994, and a mean absolute percentage error (MAPE) of 3.11 % across the entire database, significantly outperforming traditional empirical approaches. Additionally, two predictive formulae for the shear strength of PBLs are developed using the genetic algorithm and gene expression programming based on feature importance assessment by SHapley Additive exPlanations (SHAP). The newly proposed predictive formulae demonstrate high accuracy, achieving a maximum reduction in MAPE of 27.2 % compared with existing formulae, while maintaining simplicity for practical engineering applications. The proposed ML-based framework and newly developed predictive formulae significantly enhance the reliability and applicability of shear strength predictions for PBLs, supporting safer and more efficient design practices in steel–concrete composite construction. © 2025 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
