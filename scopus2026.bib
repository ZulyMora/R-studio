}

@ARTICLE{Vallverdú2025,
	author = {Vallverdú, Jordi and Rius, Gemma},
	title = {NeuroQ: Quantum-Inspired Brain Emulation},
	year = {2025},
	journal = {Biomimetics},
	volume = {10},
