@ARTICLE{Jahanmiri2025547,
	author = {Jahanmiri, Shirin and Noorian-Bidgoli, Majid},
	title = {Prediction of dynamic toughness of UHPCC type concrete based on mechanical properties using meta-heuristic algorithms},
