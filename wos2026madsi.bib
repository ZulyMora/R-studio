@article{ WOS:001828046400026,
Author = {Quan, Xing and Luan, Shancheng and Yang, Yinghao and Huang, Yuqin and
   Li, Bo and Li, Zhen and Zhan, Jinsong},
Title = {Wideband and Low Insertion Loss Microwave Bandpass Filter Inverse Design
   Method Based on Convolutional Neural Network Fitting Model and Genetic
   Algorithm},
Journal = {IEEE TRANSACTIONS ON COMPUTER-AIDED DESIGN OF INTEGRATED CIRCUITS AND
   SYSTEMS},
Year = {2026},
Volume = {45},
Number = {8},
Pages = {3551-3557},
Month = {AUG},
Abstract = {To overcome the limitations of traditional bandpass filter design
   methods, which heavily rely on designer expertise and predefined
   topology, this article proposes an inverse design methodology for
   microwave bandpass filters based on deep learning and genetic algorithms
   (GAs). The filter structures are encoded as 2-D pixelated matrices, and
   a database is constructed through electromagnetic (EM) simulations. To
   reduce the computational cost of EM simulation, the dataset is further
   expanded using symmetry, mirroring, and rotation techniques. A
   convolutional neural network (CNN) is trained to model the mapping
   between S-parameters and arbitrary pixelated structural matrices,
   thereby broadening the design space. Subsequently, an improved GA is
   employed to synthesize a filter structure that meets a specific
   frequency response requirement. A filter operating within 0.5-2.08 GHz
   is successfully synthesized, fabricated, and measured. The experimental
   results demonstrate that the proposed filter achieves a wide bandwidth,
   low insertion losses, and good spurious rejection (20 dB at 5.03 f(0)),
   benefiting from the removal of constraints imposed by predefined
   topology.},
