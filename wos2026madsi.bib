@article{ WOS:001630894700016,
Author = {Fang, Xiaoxing and Liu, Jiagang and Zhang, Yunyun and Zhao, Chen and
   Liao, Xiaoyi and Li, Huangyan},
Title = {Design of Frequency-Selective Rasorbers Based on a Hybrid Neural Network
   Framework},
Journal = {IEEE ANTENNAS AND WIRELESS PROPAGATION LETTERS},
Year = {2025},
Volume = {24},
Number = {11},
Pages = {4006-4010},
Month = {NOV},
Abstract = {This letter presents an intelligent design method for
   frequency-selective rasorbers (FSRs) based on a hybrid neural network
   framework, significantly reducing learning complexity. First, a hybrid
   modeling approach is introduced, integrating topological modeling for
   the absorber layer and parametric modeling for the frequency-selective
   surface (FSS) layer, thereby enhancing efficiency and flexibility. Next,
   a neural network framework is constructed using a variational
   autoencoder and a hybrid predictor to establish relationships between
   electromagnetic properties and FSR modeling parameters. The predictor
   consists of two sub-predictors, tailored for the absorber and FSS
   layers, respectively, and a combiner that integrates their outputs.
   Finally, the trained predictor is coupled with a genetic algorithm to
   enable intelligent FSR design. Numerical examples demonstrate the
   practicality and accuracy of the proposed method.},
